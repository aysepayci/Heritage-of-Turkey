<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Heritage of Turkey</title>
    <meta name="description" content="Explore museums, ancient cities, and cultural heritage sites across Turkey." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Cinzel:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        document.documentElement.setAttribute('data-theme', localStorage.getItem('heritage-theme') || 'light');
    </script>
</head>
<body class="d-flex min-vh-100 flex-column">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon" aria-hidden="true">⚜</span>
                    Heritage of Turkey
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Museum" asp-action="Index">Museums</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Ruin" asp-action="Index">Ruins</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Categories" asp-action="Index">Categories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Contact" asp-action="Index">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Contact" asp-action="Replies">Replies</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">
                        <li class="nav-item">
                            <button type="button" class="btn btn-sm" style="border:1px solid var(--border-soft);color:var(--text-secondary);background:transparent;font-family:var(--font-heading);font-size:.65rem;letter-spacing:.07em;text-transform:uppercase;padding:.32rem .85rem;"
                                    data-theme-toggle aria-label="Toggle theme">Dark Mode</button>
                        </li>
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        <div class="container pt-4">
            <partial name="_TempDataAlerts" />
        </div>
        @RenderBody()
    </main>

    <footer class="mt-auto py-5">
        <div class="container">
            <div class="row gy-4 align-items-start">
                <div class="col-12 col-md-5">
                    <div style="font-family:var(--font-heading);letter-spacing:.1em;text-transform:uppercase;font-size:.8rem;color:var(--gold);margin-bottom:.4rem;">Heritage of Turkey</div>
                    <p class="small mb-0" style="color:var(--text-muted);font-family:var(--font-body);">
                        Discover museums, ancient cities, and cultural routes across Turkey.
                    </p>
                </div>
                <div class="col-12 col-md-7">
                    <ul class="nav justify-content-md-end flex-wrap gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-2" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2" asp-area="" asp-controller="Museum" asp-action="Index">Museums</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2" asp-area="" asp-controller="Ruin" asp-action="Index">Ruins</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2" asp-area="" asp-controller="Contact" asp-action="Index">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>

            <hr class="gold-divider" />

            <div class="d-flex flex-column flex-md-row justify-content-between gap-2 small" style="color:var(--text-muted);">
                <span>&copy; @DateTime.Now.Year Heritage of Turkey. All rights reserved.</span>
                <span>Built with ASP.NET Core MVC &amp; Bootstrap 5.</span>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
