<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Cinzel:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Admin sidebar */
        .admin-sidebar {
            background-color: var(--surface);
            border-right: 1px solid var(--border-soft);
            min-height: 100%;
        }
        .admin-sidebar .sidebar-brand {
            font-family: var(--font-heading);
            font-size: .7rem;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--gold);
            padding: 1.25rem 1rem .5rem;
            display: block;
        }
        .admin-sidebar .section-label {
            font-family: var(--font-heading);
            font-size: .58rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--text-muted);
            padding: .75rem 1rem .25rem;
        }
        .admin-sidebar .list-group-item {
            border: none !important;
            border-radius: 6px !important;
            margin: 1px 6px;
            padding: .48rem .85rem;
            font-family: var(--font-body);
            font-size: .88rem;
            color: var(--text-secondary);
            transition: background-color .15s, color .15s;
            width: calc(100% - 12px);
        }
        .admin-sidebar .list-group-item:hover {
            background-color: var(--gold-glow) !important;
            color: var(--primary) !important;
        }
        .admin-sidebar .list-group-item.active {
            background-color: var(--primary) !important;
            color: var(--text-inverse) !important;
        }
        .admin-topbar {
            background-color: var(--surface);
            border-bottom: 1px solid var(--border-soft);
            position: relative;
        }
        .admin-topbar::after {
            content: '';
            position: absolute;
            bottom: -1px; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold), var(--gold-light), var(--gold), transparent);
            opacity: .5;
        }
    </style>
    <script>
        document.documentElement.setAttribute('data-theme', localStorage.getItem('heritage-theme') || 'light');
    </script>
</head>
<body>
    <div class="min-vh-100 d-flex flex-column">
        <!-- Top bar -->
        <header class="admin-topbar navbar navbar-expand-lg sticky-top">
            <div class="container-fluid px-3">
                <a class="navbar-brand" style="font-family:var(--font-heading);font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:var(--text);"
                   asp-route="AdminDashboard">
                    <span style="color:var(--gold);margin-right:.4rem;">⚜</span>Heritage Admin
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminTopNav"
                        aria-controls="adminTopNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminTopNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="/">← Public Site</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">
                        <li class="nav-item">
                            <button type="button"
                                    style="border:1px solid var(--border-soft);color:var(--text-secondary);background:transparent;font-family:var(--font-heading);font-size:.65rem;letter-spacing:.07em;text-transform:uppercase;padding:.32rem .85rem;border-radius:6px;cursor:pointer;"
                                    data-theme-toggle aria-label="Toggle theme">Dark Mode</button>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link" style="color:var(--text-muted);font-size:.88rem;">@User.Identity?.Name</span>
                        </li>
                        <li class="nav-item">
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary">Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Body -->
        <div class="container-fluid flex-grow-1">
            <div class="row min-vh-100">
                <!-- Sidebar -->
                <aside class="col-12 col-lg-2 p-0 admin-sidebar">
                    <nav>
                        <span class="sidebar-brand">Management</span>
                        <div class="section-label">Navigation</div>
                        <div class="list-group list-group-flush">
                            <a asp-route="AdminDashboard"
                               class="list-group-item list-group-item-action">Dashboard</a>
                            <a asp-route="AdminMuseums"
                               class="list-group-item list-group-item-action">Museums</a>
                            <a asp-route="AdminRuins"
                               class="list-group-item list-group-item-action">Ruins</a>
                            <a asp-route="AdminCategories"
                               class="list-group-item list-group-item-action">Categories</a>
                            <a asp-route="AdminContactMessages"
                               class="list-group-item list-group-item-action">Contact Messages</a>
                        </div>
                    </nav>
                </aside>

                <!-- Main content -->
                <main class="col-12 col-lg-10 px-0" style="background-color:var(--bg);">
                    <div class="container-fluid py-4 px-4">
                        <partial name="_TempDataAlerts" />
                        @RenderBody()
                    </div>
                </main>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
