@model Heritage_of_Turkey.ViewModels.Admin.CategoryAdminDetailViewModel

@{
    ViewData["Title"] = "Delete Category";
    Layout = "_AdminLayout";
    var hasRelatedContent = Model.MuseumCount > 0 || Model.RuinCount > 0;
}

<section class="bg-white border rounded-3 shadow-sm p-4 p-lg-5">
    <div class="mb-4">
        <span class="badge rounded-pill text-bg-danger mb-3">Delete</span>
        <h1 class="h3 fw-bold mb-1">Delete Category</h1>
        <p class="text-muted mb-0">Review this category before deleting it.</p>
    </div>

    @if (hasRelatedContent)
    {
        <div class="alert alert-warning" role="alert">
            This category has @Model.MuseumCount museum@(Model.MuseumCount == 1 ? "" : "s") and @Model.RuinCount ruin@(Model.RuinCount == 1 ? "" : "s"). It cannot be deleted until related content is moved or removed.
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            This action permanently deletes the category.
        </div>
    }

    <dl class="row gy-3">
        <dt class="col-sm-3 text-muted">Name</dt>
        <dd class="col-sm-9">@Model.CategoryName</dd>

        <dt class="col-sm-3 text-muted">Description</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description" : Model.Description)</dd>

        <dt class="col-sm-3 text-muted">Status</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive)
            {
                <span class="badge text-bg-success">Active</span>
            }
            else
            {
                <span class="badge text-bg-secondary">Inactive</span>
            }
        </dd>
    </dl>

    <form asp-controller="CategoryAdmin" asp-action="Delete" asp-route-id="@Model.CategoryId" method="post">
        @Html.AntiForgeryToken()
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-danger" disabled="@hasRelatedContent">Delete Category</button>
            <a asp-controller="CategoryAdmin" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>