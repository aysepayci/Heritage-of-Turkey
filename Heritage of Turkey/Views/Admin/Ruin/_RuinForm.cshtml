@model Heritage_of_Turkey.ViewModels.Admin.RuinAdminFormViewModel

@{
    var formAction = Model.RuinId == 0 ? "Create" : "Edit";
}

<form asp-controller="RuinAdmin" asp-action="@formAction" asp-route-id="@Model.RuinId" method="post" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()

    @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    }

    <input asp-for="RuinId" type="hidden" />

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="RuinName" class="form-label"></label>
                    <input asp-for="RuinName" class="form-control" />
                    <span asp-validation-for="RuinName" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="District" class="form-label"></label>
                    <input asp-for="District" class="form-control" />
                    <span asp-validation-for="District" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="7"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="bg-light rounded-3 p-3">
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">Select category</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label"></label>
                    <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label"></label>
                    <input asp-for="ImageUrl" class="form-control" />
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    <div class="form-text">Upload takes priority over manual URL.</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <div class="mb-3">
                        <img src="@Model.ImageUrl" alt="Current ruin image" class="img-fluid rounded border" />
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="TicketPrice" class="form-label"></label>
                    <input asp-for="TicketPrice" class="form-control" />
                    <span asp-validation-for="TicketPrice" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="OpeningHours" class="form-label"></label>
                    <input asp-for="OpeningHours" class="form-control" />
                    <span asp-validation-for="OpeningHours" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HistoricalPeriod" class="form-label"></label>
                    <input asp-for="HistoricalPeriod" class="form-control" />
                    <span asp-validation-for="HistoricalPeriod" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GoogleMapsUrl" class="form-label"></label>
                    <input asp-for="GoogleMapsUrl" class="form-control" placeholder="https://maps.google.com/..." />
                    <span asp-validation-for="GoogleMapsUrl" class="text-danger small"></span>
                </div>

                <div class="form-check form-switch mb-2">
                    <input asp-for="IsFeatured" class="form-check-input" />
                    <label asp-for="IsFeatured" class="form-check-label"></label>
                </div>

                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Save Ruin</button>
        <a asp-controller="RuinAdmin" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
