@model Heritage_of_Turkey.ViewModels.Admin.RuinAdminDetailViewModel

@{
    ViewData["Title"] = "Delete Ruin";
    Layout = "_AdminLayout";
    var statusBadgeClass = Model.IsActive ? "text-bg-success" : "text-bg-secondary";
    var statusText = Model.IsActive ? "Active" : "Inactive";
}

<section class="bg-white border rounded-3 shadow-sm p-4 p-lg-5">
    <div class="mb-4">
        <span class="badge rounded-pill text-bg-danger mb-3">Delete</span>
        <h1 class="h3 fw-bold mb-1">Delete Ruin</h1>
        <p class="text-muted mb-0">This action permanently deletes the ruin.</p>
    </div>

    <div class="alert alert-danger" role="alert">
        Are you sure you want to delete <strong>@Model.RuinName</strong>?
    </div>

    <dl class="row gy-3">
        <dt class="col-sm-3 text-muted">Category</dt>
        <dd class="col-sm-9">@Model.CategoryName</dd>

        <dt class="col-sm-3 text-muted">City</dt>
        <dd class="col-sm-9">@Model.City</dd>

        <dt class="col-sm-3 text-muted">Historical Period</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.HistoricalPeriod) ? "Not listed" : Model.HistoricalPeriod)</dd>

        <dt class="col-sm-3 text-muted">Status</dt>
        <dd class="col-sm-9">
            <span class="badge @statusBadgeClass">@statusText</span>
        </dd>
    </dl>

    <form asp-controller="RuinAdmin" asp-action="Delete" asp-route-id="@Model.RuinId" method="post">
        @Html.AntiForgeryToken()
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-danger">Delete Ruin</button>
            <a asp-controller="RuinAdmin" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>